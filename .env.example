# Copy to .env only if you need to change defaults. Usually not required.

# API bind
MINERU_API_HOST=127.0.0.1
MINERU_API_PORT=8001

# Output (relative to this folder — works on any machine)
MINERU_API_OUTPUT_ROOT=./output

MINERU_LOG_LEVEL=INFO
MINERU_MODEL_SOURCE=huggingface

# Optional Hugging Face token
# HF_TOKEN=
