# Copy to .env for local overrides. Never commit .env.
# MinerU also accepts these as real process environment variables.

# API bind (used by run scripts / docs; CLI flags still win if passed)
MINERU_API_HOST=127.0.0.1
MINERU_API_PORT=8001

# Output root for mineru-api tasks (default: ./output)
MINERU_API_OUTPUT_ROOT=./output

# Logging
MINERU_LOG_LEVEL=INFO

# Model source: huggingface | modelscope | local
MINERU_MODEL_SOURCE=huggingface

# Optional: Hugging Face token for higher rate limits
# HF_TOKEN=

# Backend used by parseProject when calling the mineru CLI
# (documented here for operators — parseProject reads its own .env)
# MINERU_BACKEND=pipeline
